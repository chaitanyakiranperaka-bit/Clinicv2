# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
# ==============================================================================

# Dentally NexGen REST API (v2026-01-01)
DENTALLY_BASE_URL="https://api.dentally.co"
DENTALLY_PRACTICE_ID="your-dentally-practice-uuid"
DENTALLY_CLIENT_ID="your-dentally-client-id"
DENTALLY_CLIENT_SECRET="your-dentally-client-secret"
DENTALLY_SERVER_PORT="8999"

# Google Calendar Integration (Core App)
GOOGLE_CALENDAR_ID="your-clinic-calendar@gmail.com"
GOOGLE_SERVICE_ACCOUNT_FILE="/path/to/service_account.json"

# AWS Bedrock
AWS_DEFAULT_REGION="eu-west-1"
BEDROCK_MODEL_ID="qwen.qwen3-coder-30b-a3b-v1:0"

